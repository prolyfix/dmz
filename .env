APP_ENV=dev
APP_SECRET=change-me-to-a-long-random-secret
APP_DEBUG=1

# Use sqlite for a minimal deployment footprint.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Comma-separated trusted proxy IPs/CIDRs, or leave empty.
TRUSTED_PROXIES=

# In prod, keep this at 0 so API auth requires HTTPS.
APP_ALLOW_INSECURE=1
